{
  "$schema": "https://app.kilo.ai/config.json",
  "model": "anthropic/claude-sonnet-4-5",
  "small_model": "anthropic/claude-haiku-4-5",
  "default_agent": "engineer",
  "instructions": [
    "AGENTS.md",
    "*.md"
  ],
  "plugin": [],
  "snapshot": false,
  "share": "manual",
  "autoupdate": true,
  "compaction": {
    "auto": true,
    "prune": true
  },
  "permission": {
    "bash": "allow",
    "edit": {
      "**/*": "allow"
    },
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "task": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "skill": "allow",
    "external_directory": "ask",
    "todowrite": "allow",
    "todoread": "allow",
    "question": "ask"
  }
}